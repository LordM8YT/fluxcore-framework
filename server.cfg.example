# Minimal development configuration for FiveM for GTAV Enhanced / Cfx Server.
# Copy this file outside the repository and add your own sv_licenseKey.

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "Fluxcore Framework Development"
sets sv_projectName "Fluxcore Framework"
sets sv_projectDesc "Fluxcore — an independent Enhanced-first framework"
sv_maxclients 8

# OneSync is always enabled by Cfx Server for Enhanced and its convar is
# read-only. txAdmin recipes should use `$onesync: on` instead.
set sv_stateBagStrictMode true
voice_internal

# Enables Enhanced client developer tools. Disable this in production, or
# replace it with per-player deferrals.handover access.
set sv_devMode true

# Core settings can override config/defaults.json without editing the resource.
# Use "no" for Norwegian. Keep this above every Fluxcore ensure.
setr fluxcore_locale "en"
set fluxcore_maxCharacters 4
set fluxcore_saveIntervalMs 60000
setr sv_showBusySpinnerOnLoadingScreen false

ensure fluxcore_loading
ensure fluxcore_core
ensure fluxcore_chat
ensure fluxcore_voice
ensure fluxcore_interact
ensure fluxcore_jobs
ensure fluxcore_inventory
ensure fluxcore_status
ensure fluxcore_banking
ensure fluxcore_vehicles
ensure fluxcore_fuel
ensure fluxcore_appearance
ensure fluxcore_businesses
ensure fluxcore_services
ensure fluxcore_dispatch
ensure fluxcore_mdt
ensure fluxcore_properties
ensure fluxcore_world
ensure fluxcore_ui
ensure fluxcore_admin
ensure fluxcore_phone
ensure fluxcore_identity
# Development-only API examples. Enable manually when testing integrations.
# ensure fluxcore_example

# Job-management commands are denied to players unless their principal inherits
# this ACE. Example:
# add_ace group.admin fluxcore.jobs.manage allow
# add_ace group.admin fluxcore.vehicles.manage allow
# add_ace group.admin fluxcore.businesses.manage allow
# add_ace group.admin fluxcore.admin allow

# Add this locally. Never commit a real key.
# sv_licenseKey "..."
